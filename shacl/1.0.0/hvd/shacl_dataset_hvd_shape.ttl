@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcatapes: <https://datosgobes.github.io/DCAT-AP-ES/#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .

<https://datosgobes.github.io/DCAT-AP-ES/releases/1.0.0/shacl/hvd/shacl_dataset_hvd_shape.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "Restricciones para los conjuntos de datos HVD DCAT-AP-ES"@es ;
    dcat:downloadURL <https://datosgobes.github.io/DCAT-AP-ES/releases/1.0.0/shacl/hvd/shacl_dataset_hvd_shape.ttl> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dct:conformsTo <https://www.w3.org/TR/shacl> ;
    dct:description "Este archivo incluye las restricciones SHACL para las propiedades y clases relacionadas con conjuntos de datos de alto valor (HVD) en el perfil de aplicación DCAT-AP-ES."@es ;
    owl:versionInfo "1.0.0" ;
    dct:modified "2025-10-20"^^xsd:date ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    cc:attributionURL <https://datos.gob.es/> ;
    dcatap:availability <http://data.europa.eu/r5r/stable> ;
    foaf:homepage <https://datosgobes.github.io/DCAT-AP-ES/> ;
    rdfs:seeAlso <https://datosgobes.github.io/DCAT-AP-ES/#Dataset> ;
    rdfs:comment """
        Este archivo requiere importar las siguientes dependencias adicionales para funcionar correctamente:
        - shacl_common_hvd_shape.ttl
        - shacl_common_shapes.ttl
        - shacl_mdr-vocabularies.shape.ttl
        - shacl_distribution_shape.ttl
        Asegúrese de que estén disponibles e importadas para una validación completa.
    """@es .


#--------------------------
# dcat:Dataset HVD restrictions
#--------------------------
dcatapes:Dataset_HVD_Shape
    a sh:NodeShape ;
    sh:name "Conjunto de datos HVD"@es ;
    rdfs:comment "Forma que define las restricciones para la clase dcat:Dataset HVD."@es ;
    rdfs:label "Restricciones de conjunto de datos HVD"@es ;
    foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset> ;
    sh:property 
    [
    # dcatap:applicableLegislation
        sh:path dcatap:applicableLegislation ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset.applicableLegislation> ;
        sh:message "El valor de dcatap:applicableLegislation debe ser un IRI válido."@es ;
    ],
    [
        sh:path dcatap:applicableLegislation ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset.applicableLegislation> ;
        sh:message "El conjunto de datos HVD debe contener al menos un dcatap:applicableLegislation."@es ;
    ], 
    [
        sh:path dcatap:applicableLegislation;
        sh:name "Legislación aplicable"@es;
        sh:description "La legislación aplicable debe ser el ELI del Reglamento de ejecución HVD."@es;
        sh:hasValue <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
        sh:severity sh:Violation;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset.applicableLegislation> ;
        sh:message "El conjunto de datos HVD debe contener un dcatap:applicableLegislation cuyo valor sea el ELI del Reglamento de ejecución HVD: <http://data.europa.eu/eli/reg_impl/2023/138/oj>."@es ;
    ], 

    # dcatap:hvdCategory
    [
        sh:path dcatap:hvdCategory;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset.hvdCategory> ;
        sh:message "El valor de dcatap:hvdCategory debe ser un IRI válido."@es ;
    ],
    [
        sh:path dcatap:hvdCategory;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Dataset.hvdCategory> ;
        sh:message "El conjunto de datos HVD debe contener al menos un dcatap:hvdCategory."@es ;
    ],
    [
        sh:path dcatap:hvdCategory ;
        sh:node dcatapes:HVDCategoryRestriction ;
    ];
    sh:targetClass dcat:Dataset .

# Convención 12: Modificada para permitir datasets HVD sin servicio de datos, pero informar sobre que es aconsejable.
dcatapes:Dataset_HVD_MustHaveServiceConvention
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:name "HVD sin servicio informar"@es ;
    rdfs:comment "HVD sin servicio informar"@es ;
    rdfs:label "HVD sin servicio informar"@es ;
    sh:severity sh:Info ; # Modificada severidad para no impedir la federación de datasets HVD que aún no cumplen esta convención, pero informar sobre la necesidad de cumplirla. Y eliminada comprobacion Solo aplica a datasets HVD (con dcatap:hvdCategory) pues ya se comprueba antes
    sh:property [
        # Detectar al menos un dcat:DataService mediante el inverso de dcat:servesDataset
        sh:path [ 
            sh:inversePath 
            dcat:servesDataset 
        ] ;
        sh:minCount 1 ;
        sh:class dcat:DataService ;
        sh:severity sh:Info ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-12> ;
        sh:message "Es aconsejable que un conjunto de datos HVD sea servido por al menos un dcat:DataService mediante dcat:servesDataset. Ver Convención 12: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-12"@es ;
    ] .
