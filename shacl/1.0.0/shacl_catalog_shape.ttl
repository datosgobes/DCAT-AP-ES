@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcatapes: <https://datosgobes.github.io/DCAT-AP-ES/#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .

<https://datosgobes.github.io/DCAT-AP-ES/releases/1.0.0/shacl/shacl_catalog_shape.ttl>
    rdf:type owl:Ontology ;
    rdfs:label "Restricciones para los catálogos de datos DCAT-AP-ES"@es ;
    dcat:downloadURL <https://datosgobes.github.io/DCAT-AP-ES/releases/1.0.0/shacl/shacl_distribution_shape.ttl> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dct:conformsTo <https://www.w3.org/TR/shacl> ;
    dct:description "Este archivo incluye las restricciones SHACL para las propiedades y clases relacionadas con catálogos de datos en el perfil de aplicación DCAT-AP-ES."@es ;
    owl:versionInfo "1.0.0" ;
    dct:modified "2025-10-20"^^xsd:date ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    cc:attributionURL <https://datos.gob.es/> ;
    dcatap:availability <http://data.europa.eu/r5r/stable> ;
    foaf:homepage <https://datosgobes.github.io/DCAT-AP-ES/> ;
    rdfs:seeAlso <https://datosgobes.github.io/DCAT-AP-ES/#Catalog> ;
    rdfs:comment """
        Este archivo requiere importar las siguientes dependencias adicionales para funcionar correctamente:
        - shacl_common_shapes.ttl
        - shacl_mdr-vocabularies.shape.ttl
        Asegúrese de que estén disponibles e importadas para una validación completa.
    """@es .


#--------------------------
# dcat:Catalog restrictions
#--------------------------
dcatapes:Catalog_Shape
    a sh:NodeShape ;
    sh:name "Catálogo"@es ;
    rdfs:comment "Forma que define las restricciones para la clase dcat:Catalog."@es ;
    rdfs:label "Restricciones de catálogo de datos"@es ;
    foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog> ;
    sh:property 
    [
    # dct:title
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.title> ;
        sh:message "El catálogo debe contener al menos un dct:title."@es ;
    ], 
    [
        sh:path dct:title ;
        sh:node dcatapes:LiteralMultilingualConvention ; 
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:title ;
        sh:node dcatapes:NonEmptyLiteralConvention ; 
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:title ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02> ;
        sh:message "Más de un valor comparten la misma etiqueta de idioma. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02"@es ;
    ],

    # dct:description
    [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.description> ;
        sh:message "El catálogo debe contener al menos un dct:description."@es ;
    ], 
    [
        sh:path dct:description ;
        sh:node dcatapes:LiteralMultilingualConvention ; 
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:description ;
        sh:node dcatapes:NonEmptyLiteralConvention ; 
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:description ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02> ;
        sh:message "Más de un valor comparten la misma etiqueta de idioma. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02"@es ;
    ],

    # dct:publisher
    [
        sh:path dct:publisher ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.publisher> ;
        sh:message "El catálogo debe contener al menos un dct:publisher."@es ;
    ], 
    [
        sh:path dct:publisher ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.publisher> ;
        sh:message "La propiedad dct:publisher no puede tener más de un valor."@es ;
    ],
    [
        sh:path dct:publisher ;
        sh:node dcatapes:DIR3OrganismRestriction;
        sh:or(
            [
                sh:nodeKind sh:IRI; 
                sh:closed true ;
            ]
            [
                sh:nodeKind sh:BlankNodeOrIRI;
                sh:node dcatapes:Agent_Shape;
                sh:node dcatapes:PublisherAgentRestriction;
            ]
        );
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.publisher> ;
        sh:message "El valor de dct:publisher debe ser un IRI o un nodo en blanco que cumpla con las restricciones de la forma de agente."@es ;
    ],
    [
        sh:path dct:publisher ;
        sh:or(
            [ 
                sh:nodeKind sh:IRI;
                sh:closed true ;
            ]
            [
                sh:nodeKind sh:BlankNodeOrIRI;
                sh:node dcatapes:Agent_ShapeRecommended
            ]
        );
        sh:severity sh:Warning;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.publisher> ;
        sh:message "El valor de dct:publisher debe ser un IRI o un nodo en blanco que cumpla con las restricciones de la forma de agente."@es ;
    ],

    # foaf:homepage
    [
        sh:path foaf:homepage ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.homepage> ;
        sh:message "La propiedad foaf:homepage no puede tener más de un valor."@es ;
    ], 
    [
        sh:path foaf:homepage ;
        sh:nodeKind sh:IRI; 
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.homepage> ;
        sh:message "El valor de foaf:homepage debe ser un IRI válido."@es ;
    ], 
    [
        sh:path foaf:homepage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.homepage> ;
        sh:message "El catálogo debe contener al menos un foaf:homepage."@es ;
    ], 

    # dcat:themeTaxonomy
    [
        sh:path dcat:themeTaxonomy ;
        sh:nodeKind sh:IRI; 
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.themeTaxonomy> ;
        sh:message "El valor de dcat:themeTaxonomy debe ser un IRI válido."@es ;
    ], 
    [
        # Convencion 10
        sh:path dcat:themeTaxonomy ;
        sh:hasValue <http://datos.gob.es/kos/sector-publico/sector> ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-10> ;
        sh:message "Se pueden utilizar varios temas, pero al menos <http://datos.gob.es/kos/sector-publico/sector> debe estar presente. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-10"@es ;
    ],    
    [
        # Convencion 11
        sh:path dcat:themeTaxonomy ;
        sh:or (
            [ sh:hasValue <http://datos.gob.es/kos/sector-publico/sector> ]
            [ sh:hasValue <http://publications.europa.eu/resource/authority/data-theme> ]
            [ sh:hasValue <http://inspire.ec.europa.eu/theme> ]
        );
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-11> ;
        sh:message "Se recomienda utilizar las taxonomías estándar: <http://datos.gob.es/kos/sector-publico/sector>, <http://publications.europa.eu/resource/authority/data-theme> o <http://inspire.ec.europa.eu/theme>. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-11"@es ;
    ],    
    [
        # Convencion 30
        sh:path dcat:themeTaxonomy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-30> ;
        sh:message "El catálogo debe tener al menos 1 valor para dcat:themeTaxonomy. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-30"@es ;
    ] ,

    #dct:issued
    [
        sh:path dct:issued ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.issued> ;
        sh:message "El catálogo debe contener solamente un dct:issued."@es ;
    ], 
    [
        sh:path dct:issued ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:DateOrDateTimeDataTypetConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-08> ;
        sh:message "El valor de dct:issued debe ser de un literal y de tipo xsd:date, xsd:dateTime, xsd:gYear o xsd:gYearMonth y seguir el formato ISO-8601."@es ;
    ],
    [
        sh:path dct:issued ;
        sh:sparql dcatapes:WarnDateTimeWithoutTZDConstraint ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-08> ;
        sh:message "El valor dct:issued es un xsd:dateTime sin zona horaria (TZD). Por interoperabilidad, se recomienda incluir 'Z' o un offset (por ejemplo, +01:00)."@es ;
    ],


    #dct:modified
    [
        sh:path dct:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.modified> ;
        sh:message "El catálogo debe contener solamente un dct:modified."@es ;
    ], 
    [
        sh:path dct:modified ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:DateOrDateTimeDataTypetConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-08> ;
        sh:message "El valor de dct:modified debe ser de un literal y de tipo xsd:date, xsd:dateTime, xsd:gYear o xsd:gYearMonth y seguir el formato ISO-8601."@es ;
    ],
    [
        sh:path dct:modified ;
        sh:sparql dcatapes:WarnDateTimeWithoutTZDConstraint ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-08> ;
        sh:message "El valor dct:modified es un xsd:dateTime sin zona horaria (TZD). Por interoperabilidad, se recomienda incluir 'Z' o un offset (por ejemplo, +01:00)."@es ;
    ],


    # dct:language
    [
        sh:path dct:language ;
        sh:node dcatapes:LanguageRestriction ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.language> ;
        sh:message "El valor de dct:language debe ser un IRI del vocabulario de idiomas europeo http://publications.europa.eu/resource/authority/language"@es ;
    ], 
    [
        sh:path dct:language ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.language> ;
        sh:message "El catálogo debe contener al menos un dct:language."@es ;
    ], 

    # dct:license
    [
        sh:path dct:license ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.license> ;
        sh:message "La propiedad dct:license no puede tener más de un valor."@es ;
    ], 
    [
        sh:path dct:license ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.license> ;
        sh:message "El catálogo debe contener al menos un dct:license."@es ;
    ],  
    [
        sh:path dct:license ;
        sh:or (
            [ sh:node dcatapes:LicenceDocumentRestriction ;]
            [ sh:node dcatapes:LicenceRestriction ;]
            [ sh:nodeKind sh:IRI ;]
        );
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.license> ;
        sh:message "El catálogo debe contener un documento de Licencia bien construido."@es ;
    ], 

    # dcat:dataset
    [
        sh:path dcat:dataset ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.dataset> ;
        sh:message "El valor de dcat:dataset debe ser un IRI válido."@es ;
    ],

    # dcat:service
    [
        sh:path dcat:service ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.service> ;
        sh:message "El valor de dcat:service debe ser un IRI válido."@es ;
    ],

    # dct:spatial
    [
        sh:path dct:spatial ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.spatial> ;
        sh:message "El catálogo debe contener al menos un valor para dct:spatial."@es ;
    ],
    [
        sh:path dct:spatial ;
        sh:or (
            [ 
                sh:class dct:Location ;
            ]
            [ 
                sh:node dcatapes:Spatial_Shape ;
                sh:nodeKind sh:IRI ;
            ]
        );
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.spatial> ;            
        sh:message "El valor de dct:spatial debe ser un IRI de los vocabularios permitidos o un nodo de tipo Location."@es ;
    ],

    # dcat:catalog
    [
        sh:path dcat:catalog ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.catalog> ;
        sh:message "El valor de dcat:catalog debe ser un IRI válido."@es ;
    ],

    # dcat:record    
    [  
        sh:path dcat:record ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.record> ;
        sh:message "El valor de dcat:record debe ser un IRI válido."@es ;
    ],
    # dct:creator  
    [
        sh:path dct:creator ;
        sh:or(
            [   
                sh:node dcatapes:DIR3OrganismRestriction ;  
                sh:nodeKind sh:IRI ;
                sh:closed true ;
            ]
            [
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:node dcatapes:Agent_Shape ;
                sh:or(
                    [
                        sh:node dcatapes:DIR3OrganismRestriction ;
                        sh:node dcatapes:PublisherAgentRestriction ;
                    ]
                    [
                        sh:not dcatapes:DIR3OrganismRestriction ;
                        sh:node dcatapes:CreatorAgentRestriction ;
                    ]
                );
            ]
        ); 
    ],
    [
        sh:path dct:creator ;
        sh:or(
            [ 
                sh:nodeKind sh:IRI ;
                sh:closed true ;
            ]
            [
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:node dcatapes:Agent_ShapeRecommended ;
            ]
        );
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.creator> ;
        sh:message "El valor de dct:creator debe ser un IRI o un nodo en blanco que cumpla con las restricciones de la forma de agente."@es ;
    ],

    #dct:hasPart
    [
        sh:path dct:hasPart ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.haspart> ;
        sh:message "El valor de dct:hasPart debe ser un IRI válido."@es ;
    ],

    #dct:isPartOf 
    [
        sh:path dct:isPartOf ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.ispart> ;
        sh:message "La propiedad dct:isPartOf no puede tener más de un valor."@es ;
    ], 
    [
        sh:path dct:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.ispart> ;
        sh:message "El valor de dct:isPartOf debe ser un IRI válido."@es ;
    ],

    #dct:rights
    [
        sh:path dct:rights ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.rights> ;
        sh:message "La propiedad dct:rights no puede tener más de un valor."@es ;
    ], 
    [
        sh:path dct:rights ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.rights> ;
        sh:message "El valor de dct:rights debe ser un IRI válido."@es ;
    ],
    # dct:temporal
    [
        sh:path dct:temporal ;
        sh:node dcatapes:TemporalPeriodConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog.temporal> ;
        sh:message "El dct:temporal del catálogo debe ser descrito como un dct:PeriodOfTime"@es ;
    ];
    sh:targetClass dcat:Catalog .

#--------------------------
# dcat:CatalogRecord restrictions
#--------------------------
dcatapes:CatalogRecord_Shape
    a sh:NodeShape ;
    sh:name "Registro de Catálogo"@es ;
    rdfs:comment "Forma que define las restricciones para la clase dcat:CatalogRecord."@es ;
    rdfs:label "Restricciones de registros de catálogo"@es ;
    foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord> ;
    sh:property 
    [
        # foaf:primaryTopic
        sh:path foaf:primaryTopic ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.primaryTopic> ;
        sh:message "El registro del catálogo debe contener exactamente un foaf:primaryTopic."@es ;
    ],
    [
        sh:path foaf:primaryTopic ;
        sh:or (
            [ sh:class dcat:Dataset ; ]
            [ sh:class dcat:DataService ; ]
        ) ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.primaryTopic> ;
        sh:message "El valor de foaf:primaryTopic debe ser un IRI de tipo dcat:Dataset o dcat:DataService."@es ;
    ],

    [
        # dct:modified
        sh:path dct:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:DateOrDateTimeDataTypetConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.modified> ;
        sh:message "El registro del catálogo debe contener exactamente un dct:modified."@es ;
    ],

    [
        # dct:conformsTo
        sh:path dct:conformsTo ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.conformsTo> ;
        sh:message "Se recomienda que el registro del catálogo contenga un dct:conformsTo."@es ;
    ],

    [
        # dct:issued
        sh:path dct:issued ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:DateOrDateTimeDataTypetConvention ;
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.issued> ;
        sh:message "Se recomienda que el registro del catálogo contenga un dct:issued."@es ;
    ],

    [
        # adms:status
        sh:path adms:status ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.status> ;
        sh:message "Se recomienda que el registro del catálogo contenga un adms:status."@es ;
    ],

    [
        # dct:title
        sh:path dct:title ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:LiteralMultilingualConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.title> ;
    ],
    [
        sh:path dct:title ;
        sh:node dcatapes:NonEmptyLiteralConvention ;
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:title ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02> ;
        sh:message "Más de un valor comparten la misma etiqueta de idioma. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02"@es ;
    ],

    [
        # dct:description
        sh:path dct:description ;
        sh:nodeKind sh:Literal ;
        sh:node dcatapes:LiteralMultilingualConvention ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#CatalogRecord.description> ;
    ],
    [
        sh:path dct:description ;
        sh:node dcatapes:NonEmptyLiteralConvention ;
        sh:severity sh:Violation ;
    ],
    [
        sh:path dct:description ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02> ;
        sh:message "Más de un valor comparten la misma etiqueta de idioma. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02"@es ;
    ] ;
    sh:targetClass dcat:CatalogRecord .

dcatapes:CatalogDatasetOrServiceRestriction
    a sh:NodeShape ;
    rdfs:comment "Restricción para validar que un catálogo tenga al menos un conjunto de datos (dcat:dataset) o un servicio de datos (dcat:service)."@es ;
    rdfs:label "Restricción de catálogo: conjuntos de datos o servicios"@es ;
    sh:name "Restricción del conjunto de datos o del servicio del catálogo"@es;
    sh:or (
        [
            sh:path dcat:dataset ;
            sh:minCount 1 ;
            foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog> ;
            sh:message "El catálogo debe contener al menos un conjunto de datos (dcat:dataset)."@es ;
        ]
        [
            sh:path dcat:service ;
            sh:minCount 1 ;
            foaf:page <https://datosgobes.github.io/DCAT-AP-ES/#Catalog> ;
            sh:message "El catálogo debe contener al menos un servicio de datos (dcat:service)."@es ;
          ]
    ) ;
    sh:severity sh:Violation ;
    sh:targetClass dcat:Catalog .

# Convencion 02
dcatapes:CatalogSPALanguageRestriction
    a sh:NodeShape ;
    rdfs:comment "Restricción para validar que un catálogo cumpla con las convenciones de idioma y contenido en español, incluyendo título, descripción y otros elementos clave."@es ;
    rdfs:label "Restricción de catálogo: idioma y contenido en español"@es ;
    sh:name "Restricción de catálogo para idioma y contenido en español"@es ;
    sh:node dcatapes:SpanishLanguageRestriction ;
    sh:node dcatapes:SpanishTitleRestriction ;
    sh:node dcatapes:SpanishDescriptionRestriction ;
    sh:severity sh:Violation ;
    foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-02> ;
    sh:targetClass dcat:Catalog .

# Convencion 30
dcatapes:CatalogThemeTaxonomyCoherence
    a sh:NodeShape ;
    rdfs:comment "Restricción para validar que las taxonomías utilizadas en los temas de datasets y servicios estén declaradas en dcat:themeTaxonomy del catálogo."@es ;
    rdfs:label "Restricción de coherencia entre taxonomías y temas"@es ;
    sh:name "Coherencia de taxonomías de temas"@es ;
    sh:sparql [
        sh:select """
            PREFIX dcat: <http://www.w3.org/ns/dcat#>
            
            SELECT DISTINCT $this ?theme ?themeNamespace
            WHERE {

                $this (dcat:dataset|dcat:service) ?resource .
                ?resource dcat:theme ?theme .
                
                BIND(REPLACE(STR(?theme), "^(.*/)[^/]*$", "$1") AS ?themeNamespaceStr)
                BIND(REPLACE(?themeNamespaceStr, "/$", "") AS ?themeNamespace)
                
                # Verificar que el namespace NO esté en themeTaxonomy
                FILTER NOT EXISTS {
                    $this dcat:themeTaxonomy ?taxonomy .
                    FILTER(STR(?taxonomy) = ?themeNamespace)
                }
            }
        """ ;
    ] ;
    sh:severity sh:Info ;
    foaf:page <https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-30> ;
    sh:message "Los temas utilizados en datasets o servicios provienen de taxonomías que no están declaradas en dcat:themeTaxonomy del catálogo. Ver: https://datosgobes.github.io/DCAT-AP-ES/convenciones/#convencion-30"@es ;
    sh:targetClass dcat:Catalog .
